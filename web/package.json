{
  "name": "greengrappler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/game.js --format=iife --platform=browser --target=es2020",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/game.js --format=iife --platform=browser --target=es2020 --watch",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 8080",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
